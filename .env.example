# Public frontend config only — never put service-role or AI keys here.
# Those belong on the Next.js backend (Vercel), not in this Vite SPA.

# Leave empty to use the Vite /api proxy → https://sanad-ebon.vercel.app
VITE_API_BASE_URL=

# Backend origin (used by the Vite proxy)
VITE_API_PROXY_TARGET=https://sanad-ebon.vercel.app
